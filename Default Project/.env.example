# ------------------------------------------------------------------
# Telegram bot token from @BotFather (paste after BOT_TOKEN=)
# It looks like: 123456789:AA... (keep it secret, never commit it)
# ------------------------------------------------------------------
BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

# Your personal Telegram id so the bot treats you as ADMIN.
# Get it from @userinfobot. Multiple admins: 11111,22222
ADMIN_TELEGRAM_ID=REPLACE_WITH_YOUR_TELEGRAM_ID

# HTTP server port used for webhooks (ngrok forwards to this)
PORT=3000

# Leave EMPTY to run the bot in long-polling mode (easiest for development).
# When you start ngrok, put your ngrok https URL here, e.g.:
# WEBHOOK_DOMAIN=https://xxxx-xx-xx-xx-xx.ngrok-free.app
WEBHOOK_DOMAIN=

# SQLite database file (relative to prisma/schema.prisma folder)
DATABASE_URL="file:./dev.db"

# Default currency shown across the marketplace
CURRENCY=ETB

# Seller gets a warning when a product stock drops to this value or below
LOW_STOCK_THRESHOLD=3

# Items shown per page in paginated lists
PAGE_SIZE=5